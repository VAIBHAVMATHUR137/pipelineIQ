// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//User table

model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
}

// Here comes only the lookup tables
enum Designation{
  HR,
  INTERN,
  TEAM_LEAD,
  CTO,
  FOUNDER,
  SDE
}
model ContactPersonProfile{
  id Int @id @default(autoincrement())
  rank  Designation @unique
  contacts ContactsTable[]
}
enum Stage{
  ASSIGNMENT,
  INTERVIEW,
  JOB_OFFER
}

model PipelineType{
  id  Int @id @default(autoincrement())
  stage Stage
}

enum Medium{
  PERSONAL_CONTACT,
  LINKEDIN_DM,
  OFFICIAL_EMAIL,
  COMPANY_WEBSITE,
  MEDIUM_OF_JOB_POST,
  OFFLINE_JOB_AGENCY
}

model ApplicationMediumTable{
  mediumID    Int @id @default(autoincrement())
  medium Medium
}

enum Platform{
  LINKEDIN,
  NAUKRI,
  MONSTER,
  WELLFOUND,
  SHINE,
  INSTAHYRE,
  INDEED,
  INTERNSHALA
}

model PlatformTable{
  platformID    Int @id @default(autoincrement())
  platform Platform @unique
  companies  CompanyTable[]
}

enum EmpType{
  PART_TIME,
  CONTRACTUAL,
  PPO_BASED_INTERNSHIP,
  INTERNSHIP_PAID,
  INTERNSHIP_UNPAID,
  FULL_TIME
}

model EmploymentTypeTable{
  empTypeID   Int @id @default(autoincrement())
  empType EmpType
}

model ContactsTable{
  id    Int @id @default(autoincrement())
  name String 
  companyID Int
  roleID Int 
  roleInfo  ContactPersonProfile @relation(
    fields:[roleID],
    references:[id]
  )
  companyInfo CompanyTable @relation(
    fields:[companyID],
    references:[ID]
  )
}

model CompanyTable{
    id    Int @id @default(autoincrement())
    name String  @unique
    location String
    sourceID  Int
    platformInfo  PlatformTable @relation(
      fields:[sourceID],
      references:[platformID]
    )
}