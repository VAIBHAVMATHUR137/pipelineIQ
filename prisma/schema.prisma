// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Use table

model User {
  id       Int             @id @default(autoincrement())
  name     String
  email    String          @unique
  password String
  openings OpeningTable[]
  outreach OutreachTable[]
  response ResponseTable[]
}

model CompanyTable {
  id   Int    @id @default(autoincrement())
  name String

  openings OpeningTable[]
  contacts ContactsTable[]
  outreach OutreachTable[]


}

enum Platform {
  PERSONAL_CONTACT
  LINKEDIN_DM
  OFFICIAL_EMAIL
  COMPANY_WEBSITE
  MEDIUM_OF_JOB_POST
  OFFLINE_JOB_AGENCY
  LINKEDIN_POST
  NAUKRI
  SHINE
  MONSTER
  WELLFOUND
  INDEED
  INSTAHYRE
  INTERNSHALA
}

model PlatformTable {
  id       Int      @id @default(autoincrement())
  platform Platform @unique

  openings OpeningTable[]
}

enum EmploymentType {
  PAID_INTERNSHIP
  PART_TIME
  CONTRACTUAL
  PPO_BASED_INTERNSHIP
  UNPAID_INTERNSHIP
  FULL_TIME
}

model employmentTypeTable {
  id       Int            @id @default(autoincrement())
  emp_type EmploymentType
  openings OpeningTable[]
}

model OpeningTable {
  id        Int    @id @default(autoincrement())
  userID    Int
  companyID Int
  sourceID  Int
  location  String
  title     String
  emp_type  Int

  users      User                @relation(fields: [userID], references: [id])
  company    CompanyTable        @relation(fields: [companyID], references: [id])
  platform   PlatformTable       @relation(fields: [sourceID], references: [id])
  employment employmentTypeTable @relation(fields: [emp_type], references: [id])

  @@unique([userID, companyID, sourceID])
}

enum rank {
  HR
  INTERN
  CTO
  FOUNDER
  TEAM_LEAD
  SDE
}

model ContactPersonProfile {
  id       Int             @id @default(autoincrement())
  Rank     rank            @unique
  contacts ContactsTable[]
}

model ContactsTable {
  id        Int    @id @default(autoincrement())
  userID    Int
  name      String
  profileID Int
  companyID Int

  outreach OutreachTable[]
  profile  ContactPersonProfile @relation(fields: [profileID], references: [id])
  company  CompanyTable         @relation(fields: [companyID], references: [id])
  @@unique([userID,name,profileID,companyID])
}

model OutreachTable {
  id               Int      @id @default(autoincrement())
  userID           Int
  companyID        Int
  contactID        Int
  time_of_approach DateTime
  followUpOf       Int?

  response ResponseTable[]
  user     User            @relation(fields: [userID], references: [id])
  company  CompanyTable    @relation(fields: [companyID], references: [id])
  contacts ContactsTable   @relation(fields: [contactID], references: [id])
}

enum Reply {
  LEFT_ON_SEEN
  REFERRED_TO_OTHER
  SOFT_REJECT
  OUTRIGHT_REJECT
  POSITIVE
  GHOSTED
}

model ReplyTable {
  id       Int             @id @default(autoincrement())
  reply    Reply           @unique
  response ResponseTable[]
}

enum stage {
  ASSIGNMENT
  INTERVIEW
  JOB_OFFER
  WAITING_FOR_PROCESS
}

model StageTable {
  id    Int   @id @default(autoincrement())
  Stage stage @unique

  responses ResponseTable[]
}

model ResponseTable {
  id                Int      @id @default(autoincrement())
  userID            Int
  time_of_reply     DateTime
  outreach_id       Int
  reply_id          Int
  positive_response Int
  stage_id          Int

  user     User          @relation(fields: [userID], references: [id])
  outreach OutreachTable @relation(fields: [outreach_id], references: [id])
  stage    StageTable    @relation(fields: [stage_id], references: [id])
  response ReplyTable    @relation(fields: [positive_response], references: [id])
}
