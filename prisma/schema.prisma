// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//User table

model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
}

enum Designation {
  HR
  INTERN
  TEAM_LEAD
  CTO
  FOUNDER
  SDE
}

model ContactPersonProfile{
  id  Int @id @default(autoincrement())
  rank Designation @unique
  contacts ContactsTable[]
}

model ContactsTable {
  id        Int    @id @default(autoincrement())
  name      String?
  companyID Int
  profileID Int

  outreachRelation outreachTable[]

  profile ContactPersonProfile @relation(fields: [profileID], references: [id])
  company CompanyTable    @relation(fields:[companyID],references:[id])
 

}
//lookup table for platform and type of employment

enum PlatformType{
  PERSONAL_CONTACT
  LINKEDIN_DM
  OFFICIAL_EMAIL
  COMPANY_WEBSITE
  MEDIUM_OF_JOB_POST
  OFFLINE_JOB_AGENCY
  LINKEDIN
  NAUKRI
  MONSTER
  WELLFOUND
  INDEED
  INSTAHYRE
  INTERNSHALA
}

model platformTable{
  id Int @id @default(autoincrement())
  platform PlatformType @unique
  client CompanyTable[]
}

enum emp{
    PART_TIME
    CONTRACTUAL
    PPO_BASED_INTERNSHIP
    PAID_INTERNSHIP
    UNPAID_INTERNSHIP
    FULL_TIME
}

model employmentTypeTable{
  id    Int   @id   @default(autoincrement())
  empType emp @unique
  companies CompanyTable[]
}

model CompanyTable{
    id    Int   @id   @default(autoincrement())
    name    String   
    location    String
    title   String
    emp_type    Int
    source_id   Int 

    platform platformTable @relation(fields:[source_id],references:[id])
    employment  employmentTypeTable @relation(fields:[emp_type],references:[id])

    outreach outreachTable[]
    contacts ContactsTable[]
}

//lookup table for reply
enum replyType{
  LEFT_ON_SEE
  REFERRED_TO_OTHER
  SOFT_REJECT
  OUTRIGHT_REJECT
  POSITIVE
  GHOSTED
}
model replyTable{
  id    Int   @id   @default(autoincrement())
  reply replyType @unique
  replyRelation responseTable[]
}
enum  stageType{
  ASSIGNMENT
  INTERVIEW
  JOB_OFFER
  WAITING_FOR_PROCESS
}
model stageTable{
  id    Int   @id   @default(autoincrement())
  stage  stageType @unique
  stageRelation responseTable[]
}
model outreachTable{
  id    Int   @id @default(autoincrement())
  companyID   Int 
  contactID   Int   
  time_of_approach  DateTime
  followUpOf Int?
  response responseTable[]
  company CompanyTable @relation(fields:[companyID],references:[id])
  contact ContactsTable @relation(fields:[contactID],references:[id])


}
model responseTable{
  id    Int @id @default(autoincrement())
  time_of_reply   DateTime
  outreach_id Int
  reply_id  Int
  positive_response  Int
  stage_id    Int
  outreach outreachTable @relation(fields:[outreach_id],references:[id])
  reply replyTable @relation(fields:[reply_id], references:[id])
  stage stageTable @relation(fields:[stage_id],references:[id])
}